@@ -0,0 +1,86 @@
+# v6 capacity study (results/v6/REPORT.md): AL-14M, 14,204,928 parameters. Identical to configs/final/TR.yaml except
+# ALiBi, 512-character windows x batch 32 (16,384 training characters per update, as TR.yaml's 128 x 128),
+# selection by validation accuracy (BPC tie-break), one stage checkpoint (disk), the model size, and the
+# validation-split evaluation at W = 512 with stride 128. The learning rate is set per model by the v6 search (--set).
+model_name: AL-14M
+
+model:
+  type: transformer
+  vocab_size: 27
+  d_model: 384
+  n_heads: 6
+  n_layers: 8
+  max_len: 512
+  mlp_ratio: 4
+  emb_dropout: 0.0
+  mlp_dropout: 0.0
+  attn_dropout: 0.0
+  resid_dropout: 0.0
+  # position encoding type: 'sinusoidal', 'learned', 'hybrid', 'rope', 'alibi', 'relative', 'none' (NoPE)
+  pos_encoding_type: 'alibi'
+  # scaling of the fixed sinusoidal table ('sinusoidal' and the sinusoidal half of 'hybrid'):
+  # 'unit' = every row has norm 1 (default); 'raw' = unscaled, row norm sqrt(d_model/2) (~11.3 at d_model 256)
+  sinusoidal_scale: unit
+
+loss:
+  LABEL_SMOOTHING: True
+  # 0.0 = label smoothing off (chosen by the v3 search; same loss as LABEL_SMOOTHING: False)
+  ls_eps: 0.0
+  # entropy bonus weight
+  entropy_lambda: 0.0
+  # position weights mode, linear, sqrt, none
+  tail_scheme: 'linear'
+
+scheduler:
+  warmup_iters: 2000
+  init_value: 0.0
+  end_value: 0.0
+
+optimizer:
+  # AdamW (after clip_by_global_norm(grad_clip_norm)); these were hard-coded in the notebook
+  b1: 0.9
+  b2: 0.95
+  eps: 1.0e-8
+  weight_decay: 0.1
+  grad_clip_norm: 1.0
+  # true: decay only leaves with ndim >= 2 (never biases, LayerNorm, or rel_embed); false: decay everything
+  decay_mask: true
+
+training:
+  batch_size: 32
+  sequence_length: 512
+  learning_rate: 0.0018
+  epochs: 50000
+  validation_interval: 500
+  stage_checkpoint_interval: 50000
+  # 'acc': checkpoint with the highest fixed-validation accuracy, ties broken by the lower loss (= lower BPC)
+  checkpoint_selection: acc
+  seed: 4212   # overridden by train.py --seed
+
+evaluation:
+  sample: True
+  seed: 4212
+  # prompt for text generation
+  prompt: "hello my fri"
+  # length of text to generate
+  gen_len: 1000
+  # temperature for text generation
+  temperature: 0.7
+  self_belu_n_grams: 4
+  self_belu_n_samples: 20
+  # sliding-window test evaluation (utils/full_context_eval.py): window = model.max_len
+  full_context_stride: 1
+  full_context_batch_size: 256
+  # multi-prompt Self-BLEU: n_prompts passages of prompt_len chars from the validation split (fixed offsets, seed 0),
+  # n_samples continuations per prompt (one batch); Self-BLEU within each prompt, mean +- std over prompts
+  self_bleu_multi_n_prompts: 10
+  self_bleu_multi_n_samples: 20
+  self_bleu_multi_prompt_len: 128
+  # --tuning: full-context evaluation of the validation split with this stride (the test file is never opened)
+  tuning_val_stride: 128
+
+output:
+  # directory to save model checkpoints
+  checkpoint_dir: ./checkpoints
+  # directory to save training and evaluation results
+  results_dir: ./runs
